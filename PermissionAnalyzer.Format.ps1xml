<?xml version="1.0" encoding="utf-8"?>
<!-- PermissionAnalyzer custom format views -->
<Configuration>
  <ViewDefinitions>

    <!-- PA.Finding — the primary output operators triage interactively -->
    <View>
      <Name>PA.Finding.Table</Name>
      <ViewSelectedBy>
        <TypeName>PA.Finding</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Severity</Label>
            <Width>9</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Category</Label>
            <Width>17</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Principal</Label>
            <Width>20</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Role</Label>
            <Width>20</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Scope</Label>
            <Width>24</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Days</Label>
            <Width>5</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Action</Label>
            <Width>16</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Severity</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Category</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>PrincipalDisplayName</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>RoleName</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Scope</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>DaysSinceActive</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>RemediationAction</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <!-- PA.CollectorResult — pipeline stage status at a glance -->
    <View>
      <Name>PA.CollectorResult.Table</Name>
      <ViewSelectedBy>
        <TypeName>PA.CollectorResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Collector</Label>
            <Width>32</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Status</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Items</Label>
            <Width>8</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Warnings</Label>
            <Width>10</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Errors</Label>
            <Width>8</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>12</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Collector</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Status</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ItemCount</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Warnings.Count</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Errors.Count</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>'{0:N1}s' -f $_.Duration.TotalSeconds</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <!-- PA.ValidationResult — finding re-validation outcome -->
    <View>
      <Name>PA.ValidationResult.Table</Name>
      <ViewSelectedBy>
        <TypeName>PA.ValidationResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>FindingId</Label>
            <Width>18</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Category</Label>
            <Width>20</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Severity</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Valid</Label>
            <Width>6</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>CurrentState</Label>
            <Width>32</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Notes</Label>
            <Width>30</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>FindingId</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>OriginalCategory</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>OriginalSeverity</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IsStillValid</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>CurrentState</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Notes</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <!-- PA.AuditResult — end-to-end orchestrator summary -->
    <View>
      <Name>PA.AuditResult.List</Name>
      <ViewSelectedBy>
        <TypeName>PA.AuditResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Run ID</Label>
                <PropertyName>RunId</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Tenant</Label>
                <PropertyName>TenantId</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Environment</Label>
                <PropertyName>Environment</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Assignments</Label>
                <PropertyName>TotalAssignments</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Activity Profiles</Label>
                <PropertyName>TotalActivityProfiles</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Total Findings</Label>
                <PropertyName>TotalFindings</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Critical</Label>
                <ScriptBlock>$_.FindingsBySeverity['Critical']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>High</Label>
                <ScriptBlock>$_.FindingsBySeverity['High']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Medium</Label>
                <ScriptBlock>$_.FindingsBySeverity['Medium']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Low</Label>
                <ScriptBlock>$_.FindingsBySeverity['Low']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Info</Label>
                <ScriptBlock>$_.FindingsBySeverity['Info']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Duration</Label>
                <ScriptBlock>'{0:N1}s' -f $_.Duration.TotalSeconds</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Warnings</Label>
                <ScriptBlock>$_.Warnings.Count</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Errors</Label>
                <ScriptBlock>$_.Errors.Count</ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- PA.ReportResult — report generation summary -->
    <View>
      <Name>PA.ReportResult.List</Name>
      <ViewSelectedBy>
        <TypeName>PA.ReportResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Run ID</Label>
                <PropertyName>RunId</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Findings</Label>
                <PropertyName>FindingCount</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Formats</Label>
                <ScriptBlock>$_.Formats -join ', '</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Files</Label>
                <ScriptBlock>$_.OutputFiles.Count</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Output Directory</Label>
                <PropertyName>OutputDirectory</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Duration</Label>
                <ScriptBlock>'{0:N1}s' -f $_.Duration.TotalSeconds</ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <!-- PA.RemediationResult — remediation script generation summary -->
    <View>
      <Name>PA.RemediationResult.List</Name>
      <ViewSelectedBy>
        <TypeName>PA.RemediationResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Run ID</Label>
                <PropertyName>RunId</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Findings</Label>
                <PropertyName>FindingCount</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Scripts</Label>
                <ScriptBlock>$_.ScriptPaths.Count</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Remove</Label>
                <ScriptBlock>$_.OperationCounts['Remove']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Downgrade</Label>
                <ScriptBlock>$_.OperationCounts['Downgrade']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Consolidate</Label>
                <ScriptBlock>$_.OperationCounts['ConsolidateToGroup']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Review Eligible</Label>
                <ScriptBlock>$_.OperationCounts['ReviewEligible']</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Output Directory</Label>
                <PropertyName>OutputDirectory</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Duration</Label>
                <ScriptBlock>'{0:N1}s' -f $_.Duration.TotalSeconds</ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

  </ViewDefinitions>
</Configuration>
